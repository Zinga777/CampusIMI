# CampusIMI — environment configuration
# Copy to .env for local development. Never commit real secrets.

# --- College access control ---
COLLEGE_NAME="Example College of Engineering"
# Comma-separated list. Supports multiple domains (per-department + general).
COLLEGE_EMAIL_DOMAINS="cse.college.edu,ece.college.edu,college.edu"

# --- Auth / sessions ---
SESSION_SECRET="dev-only-change-me-please-use-a-long-random-string"
# Minutes an OTP stays valid.
OTP_TTL_MINUTES=10
# Days a session stays valid.
SESSION_TTL_DAYS=30

# --- AI (optional, advisory features only — never given PII) ---
AI_API_KEY=""
AI_PROVIDER="none"

# --- Storage ---
R2_BUCKET_NAME="campusimi-media"

# --- Rate limits (per user, configurable) ---
RATE_LIMIT_POSTS_PER_HOUR=10
RATE_LIMIT_COMMENTS_PER_MINUTE=5
RATE_LIMIT_LIKES_PER_MINUTE=30
RATE_LIMIT_CONFESSIONS_PER_HOUR=10
RATE_LIMIT_MESSAGES_PER_MINUTE=20
RATE_LIMIT_AI_PER_HOUR=20
