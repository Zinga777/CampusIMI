# CampusIMI — environment configuration reference
#
# IMPORTANT: this file documents every variable the Worker uses, but a root
# `.env` file is NOT automatically read by anything in this repo (no dotenv,
# no process.env reads). The Worker actually gets these values from two real
# places:
#   - apps/api/wrangler.toml   [vars] block — everything below EXCEPT secrets
#     (already filled in with working local-dev defaults; edit values there)
#   - apps/api/.dev.vars       — the two secrets below (SESSION_SECRET,
#     AI_API_KEY). Copy apps/api/.dev.vars.example to apps/api/.dev.vars and
#     fill it in; this file is gitignored and never committed.
# Use this file as a single reference for what's configurable and why; it
# doubles as the source of truth if you later move config to real env vars
# (e.g. for a CI pipeline). Never commit real secrets anywhere.

# --- College access control ---
COLLEGE_NAME="Example College of Engineering"
# Comma-separated list. Supports multiple domains (per-department + general).
COLLEGE_EMAIL_DOMAINS="cse.college.edu,ece.college.edu,college.edu"

# --- CORS ---
# Comma-separated list of exact origins allowed to make credentialed requests to the
# API. Never reflect an arbitrary request origin here — that would let any website
# make cookie-authenticated requests on a logged-in user's behalf.
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Auth / sessions ---
SESSION_SECRET="dev-only-change-me-please-use-a-long-random-string"
# Minutes an OTP stays valid.
OTP_TTL_MINUTES=10
# Days a session stays valid.
SESSION_TTL_DAYS=30

# --- AI (optional, advisory features only — never given PII) ---
AI_API_KEY=""
AI_PROVIDER="none"

# --- Storage ---
# The R2 bucket name/binding itself is configured in apps/api/wrangler.toml
# ([[r2_buckets]]), not read from an env var — nothing to set here for local dev.

# --- Rate limits (per user, configurable) ---
RATE_LIMIT_POSTS_PER_HOUR=10
RATE_LIMIT_COMMENTS_PER_MINUTE=5
RATE_LIMIT_LIKES_PER_MINUTE=30
RATE_LIMIT_CONFESSIONS_PER_HOUR=10
RATE_LIMIT_MESSAGES_PER_MINUTE=20
RATE_LIMIT_AI_PER_HOUR=20
